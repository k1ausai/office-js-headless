{
  "name": "office-js-headless",
  "version": "1.0.0",
  "description": "Headless Office.js runtime for testing Word add-ins without real Word",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "postbuild": "cp dist/index.d.ts dist/index.d.cts",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type:check": "tsc --noEmit",
    "pack:check": "publint && attw --pack .",
    "prepare": "husky"
  },
  "keywords": [
    "office-js",
    "word",
    "ooxml",
    "testing",
    "headless"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k1ausai/office-js-headless.git"
  },
  "homepage": "https://github.com/k1ausai/office-js-headless#readme",
  "bugs": {
    "url": "https://github.com/k1ausai/office-js-headless/issues"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.6",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.1.1",
    "@types/office-js": "^1.0.503",
    "@types/office-runtime": "^1.0.35",
    "@vitest/coverage-v8": "^3.0.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "publint": "^0.3.22",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^3.0.4"
  }
}
